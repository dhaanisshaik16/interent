# LearnLite Configuration
# Cloud Backend is OPTIONAL. If unconfigured, LearnLite runs in 100% functional local/demo mode.
# When internet is unavailable or credentials are omitted, local storage (IndexedDB) is used exclusively,
# and offline sync operations remain queued safely.

# Optional Supabase Integration for multi-device sync
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Metadata
VITE_APP_VERSION=1.0.0
VITE_ENABLE_MOCK_SYNC_SERVER=true
